# Public base URL, used for canonical/hreflang/sitemap/OG. Baked at build time.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# ── Server-only. Never prefix these with NEXT_PUBLIC_. ─────────────────────
# CRM API base. Production: the CRM backend's public URL, e.g. https://api.crm-iservice.uz/api/v1
# Local: `npm run mock-crm` serves a fake CRM on :8099, or point at crm-backend on :8080.
CRM_API_URL=http://localhost:8099/api/v1
# Shared only by this site and the CRM API (header X-Site-Key). Generate: openssl rand -hex 32
SITE_API_KEY=dev-site-key-change-me-0000000000000000

# Rate limit for POST /api/requests, per IP. Best effort on Vercel (per function instance);
# the CRM's per-phone cap is the authoritative limit.
RATE_LIMIT_PER_10MIN=5
RATE_LIMIT_PER_DAY=20
# Anti-bot: submissions faster than this many seconds after opening the form are dropped.
MIN_FILL_SECONDS=3
