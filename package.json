{
  "name": "iservice-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint src e2e e2e-live",
    "typecheck": "tsc --noEmit",
    "i18n:check": "node scripts/i18n-check.mjs",
    "test": "vitest run",
    "e2e": "playwright test --grep-invert @perf && playwright test --grep @perf --project=phone --workers=1",
    "mock-crm": "node mock-crm/server.mjs",
    "images": "node scripts/optimize-images.mjs",
    "budget": "node scripts/check-bundle.mjs",
    "verify": "npm run typecheck && npm run i18n:check && npm run lint && npm run test && npm run build && npm run budget",
    "lhci": "lhci autorun",
    "e2e:live": "playwright test --config playwright.live.config.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-dialog": "^1.2.0",
    "clsx": "^2.1.1",
    "next": "^15.5.27",
    "next-intl": "^4.14.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.90.0",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "postcss": "^8.5.29",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
