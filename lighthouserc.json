{
  "ci": {
    "collect": {
      "startServerCommand": "CRM_API_URL=http://127.0.0.1:8199/api/v1 SITE_API_KEY=e2e-site-key-0000000000000000 npx next start -p 3102",
      "startServerReadyPattern": "Ready",
      "url": [
        "http://127.0.0.1:3102/ru",
        "http://127.0.0.1:3102/uz",
        "http://127.0.0.1:3102/ru/order",
        "http://127.0.0.1:3102/uz/order"
      ],
      "numberOfRuns": 3,
      "settings": {
        "onlyCategories": [
          "performance",
          "accessibility",
          "best-practices",
          "seo"
        ],
        "skipAudits": [
          "uses-http2"
        ]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9,
            "aggregationMethod": "median"
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.02,
            "aggregationMethod": "median"
          }
        ],
        "total-blocking-time": [
          "error",
          {
            "maxNumericValue": 200,
            "aggregationMethod": "median"
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 3500,
            "aggregationMethod": "median"
          }
        ],
        "total-byte-weight": [
          "error",
          {
            "maxNumericValue": 480000
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
